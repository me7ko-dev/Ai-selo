{
  "name": "balkanski-legendi",
  "productName": "Балкански легенди",
  "version": "0.1.0",
  "description": "3D ролева игра в свят от българските митове с живо ИИ село",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4180",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "shot": "node test/shot.mjs",
    "exe": "npm run build && node desktop/build.mjs",
    "desktop": "electron desktop/main.cjs"
  },
  "dependencies": {
    "@fontsource/philosopher": "^5.3.0",
    "@fontsource/ruslan-display": "^5.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@types/node": "^22.10.0",
    "@types/three": "^0.180.0",
    "electron": "^44.5.1",
    "playwright-core": "1.56.1",
    "tsx": "^4.20.0",
    "typescript": "5.9",
    "vite": "^7.3.6"
  }
}
